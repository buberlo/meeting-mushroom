# Required
# OpenAI API key used by the Vercel AI SDK to extract decision spores.
OPENAI_API_KEY=sk-your-openai-api-key

# Optional: OpenAI model settings
# Model used for structured spore extraction. Any OpenAI chat model works.
OPENAI_MODEL=gpt-4o-mini

# Base URL for OpenAI-compatible providers.
# Leave unset to use the default OpenAI API endpoint.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Sampling and token limits for extraction calls.
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=1200

# Optional timeout in milliseconds for AI SDK provider requests.
# OPENAI_TIMEOUT=30000

# Optional: local SQLite storage
# Path to the SQLite file. Relative paths resolve from the project root.
DATABASE_PATH=./data/spores.db

# Optional: app metadata
NEXT_PUBLIC_APP_NAME=Spore Mycelium

# Optional: client-side API base URL
# Useful when the frontend is served from a different origin than the API.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3000